        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Object {\n        #game_: Game&amp;\n        #children_: vector~Object*~\n        #type_: ObjectType\n        #is_active_: bool\n        #is_pending_kill_: bool\n    }\n\n    class ObjectScreen {\n        #screenPosition_: vec2\n    }\n\n    class ObjectWorld {\n        #position_: vec2\n        #collider_: Collider*\n    }\n\n    class Actor {\n        #velocity_: vec2\n        #maxSpeed_: float\n    }\n\n    class Player {\n        -sprite_idle_: SpriteAnim*\n        -sprite_move_: SpriteAnim*\n        -is_moving_: bool\n    }\n\n    class Enemy {\n        -target_: Player*\n        -sprite_move_: SpriteAnim*\n        -sprite_hurt_: SpriteAnim*\n        -sprite_dead_: SpriteAnim*\n        -sprite_cur_: SpriteAnim*\n        -cur_state_: EnemyState\n    }\n\n    class ObjectAffiliate {\n        #parent_: ObjectScreen*\n        #offset_: vec2\n        #size_: vec2\n    }\n\n    class Sprite {\n        #texture_: Texture\n        #is_finish_: bool\n    }\n\n    class SpriteAnim {\n        -cur_frame_: int\n        -total_frame_: int\n        -FPS: int\n        -time_counter_: float\n        -is_loop_: bool\n    }\n\n    class Collider {\n        -collider_type_: ColliderType\n    }\n\n    class Texture {\n        +texture: SDL_Texture*\n        +src_rect: SDL_FRect\n        +angle: float\n        +is_flip: bool\n    }\n\n    class Scene {\n        #wordSize_: vec2\n        #cameraPosition_: vec2\n        -cameraBorderOffset_: vec2\n        #screenChildren_: vector~ObjectScreen*~\n        #worldChildren_: vector~ObjectWorld*~\n    }\n\n    class SceneMain {\n        -gridWidth_: float\n        -borderWidth_: float\n        -gridColor_: SDL_FColor\n        -player_: Player*\n    }\n\n    class Game {\n        -assetStore_: AssetStore*\n        -currentScene_: Scene*\n        -isRunning_: bool\n        -screenSize_: vec2\n        -window_: SDL_Window*\n        -renderer_: SDL_Renderer*\n        -mixer_: MIX_Mixer*\n        -FPS_: Uint64\n        -frameDelay_: Uint64\n        -dt_: float\n    }\n\n    class AssetStore {\n        -game_: Game&amp;\n        -textures_: map\n        -audios_: map\n        -fonts_: map\n    }\n\n    class ObjectType {\n        &lt;&lt;enumeration&gt;&gt;\n        OBJECT_NONE\n        OBJECT_SCREEN\n        OBJECT_WORLD\n    }\n\n    class EnemyState {\n        &lt;&lt;enumeration&gt;&gt;\n        MOVE\n        HURT\n        DEAD\n    }\n\n    class ColliderType {\n        &lt;&lt;enumeration&gt;&gt;\n        COLLIDER_RECTANGLE\n        COLLIDER_CIRCLE\n    }\n\n    Object &lt;|-- ObjectScreen\n    ObjectScreen &lt;|-- ObjectWorld\n    ObjectWorld &lt;|-- Actor\n    Actor &lt;|-- Player\n    Actor &lt;|-- Enemy\n    Object &lt;|-- ObjectAffiliate\n    ObjectAffiliate &lt;|-- Sprite\n    Sprite &lt;|-- SpriteAnim\n    ObjectAffiliate &lt;|-- Collider\n    Object &lt;|-- Scene\n    Scene &lt;|-- SceneMain\n\n    Game *-- AssetStore : owns\n    Game *-- Scene : owns\n    SceneMain *-- Player : owns\n    SceneMain *-- Enemy : owns\n    Player *-- SpriteAnim : owns\n    Enemy *-- SpriteAnim : owns\n    Scene o-- ObjectScreen : screenChildren_\n    Scene o-- ObjectWorld : worldChildren_\n    Object o-- Object : children_\n    Sprite *-- Texture : owns\n    ObjectWorld *-- Collider : owns\n    Collider ..&gt; ColliderType : collider_type_\n    ObjectAffiliate ..&gt; ObjectScreen : parent_\n    Enemy ..&gt; Player : target_\n    Enemy ..&gt; EnemyState : cur_state_\n    Object ..&gt; Game : ref\n    AssetStore ..&gt; Game : ref\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7x71e6qQDenC9cHN-zFu-164">
